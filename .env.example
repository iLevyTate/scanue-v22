# SCANUE-V environment variables
#
# Copy this file to `.env` and fill in only the values your configured
# providers actually need (see config/agents.yaml). A fully-local Ollama
# setup needs none of these.

# Required only if any agent in config/agents.yaml uses provider: "openai"
OPENAI_API_KEY=

# Required only if any agent uses provider: "huggingface"
HUGGINGFACEHUB_API_TOKEN=

# Optional legacy fallback model names (only used when an agent has no model
# configured in config/agents.yaml). Values are treated as OpenAI model names.
# DLPFC_MODEL=
# VMPFC_MODEL=
# OFC_MODEL=
# ACC_MODEL=
# MPFC_MODEL=

# --- Optional runtime tuning (defaults shown) ---

# Log level for diagnostics on stderr: DEBUG, INFO, WARNING, ERROR.
# SCANUE_LOG_LEVEL=WARNING

# Where feedback_history.json and logs/ live. Defaults to the project root, so
# the CLI finds the same state no matter which directory you launch it from.
# SCANUE_STATE_DIR=

# Session logs to keep; older ones are pruned after each run. 0 disables pruning.
# SCANUE_LOG_RETENTION=50

# Bounds on the HITL feedback history injected into every prompt. This history
# persists across sessions and grows forever; without these, ~25 entries fill an
# 8k context window and every agent starts failing at once.
# SCANUE_FEEDBACK_MAX_ENTRIES=5
# SCANUE_FEEDBACK_CHAR_BUDGET=4000
# SCANUE_FEEDBACK_RESPONSE_CHARS=500
